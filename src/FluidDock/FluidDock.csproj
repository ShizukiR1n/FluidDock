<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>FluidDock</RootNamespace>
    <AssemblyName>FluidDock</AssemblyName>
    <!--
      The one place the version number lives. The panel shows it and the updater compares it
      against the release tag, so the tag for this build is v0.6 - bump both together.
    -->
    <Version>0.6.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Composition + Win32 interop relies on built-in COM marshalling. -->
    <EnableComHosting>false</EnableComHosting>
    <ApplicationIcon>assets\tray.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Also shipped as a loose file, not only compiled into the exe. The tray loads it from disk so
      the icon can be swapped without a rebuild, and falls back to the exe's own icon if it is
      missing. Generated by tools\MakeTrayIcon.ps1 - it is a real multi-size icon, and hand-editing
      it back down to one size would put the bilinear downscale it exists to avoid right back.
    -->
    <Content Include="assets\tray.ico" CopyToOutputDirectory="PreserveNewest">
      <!--
        Kept out of the single-file bundle. Bundled, it is not on disk to be swapped, and the
        tray silently falls back to the exe's own icon - the loose copy the comment above
        promises would simply not exist in the shipped package.
      -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Shell icon extraction + PNG decode to raw BGRA. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!--
      Composition has no way to load an image on its own: LoadedImageSurface lives in
      Windows.UI.Xaml.Media, which does not exist in the desktop projection. Icons are
      therefore drawn into a CompositionDrawingSurface through Direct2D.
    -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

</Project>
